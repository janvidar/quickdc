# Two cores meet on a's local hub over loopback: main chat, then a private message.

# Taken as the files' contents before either core starts, so neither binds the
# default port, maps one through the gateway or asks a server outside about it.
# Port 0 is one port picked for TCP and UDP alike, which CoreStatus tells.
preset application Network Mode advanced
preset application Network Bind 127.0.0.1
preset application Network Bind6 ""
preset application Network Port 0

# Applied live, as a settings page would; the hub takes a turn to follow, and
# CoreStatus says when it takes logins.
@a set application User Nickname alice
@b set application User Nickname bob
@a set application "Local hub" Enabled 1
@a wait CoreStatus localHub=true tcp=true udp=true port!=0 remember PORT=port

# Neither login waits for the other.
@a open adc://127.0.0.1:$PORT as hub
@a connect hub
@b open adc://127.0.0.1:$PORT as hub
@b connect hub
@a wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@b wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@a wait UserJoined hub=hub nick=bob

# A private message is addressed by the id b has seen alice under.
@b wait UserUpdated hub=hub user.nick=alice

@b chat hub hello from bob
@a wait ChatReceived hub=hub line.text="hello from bob" line.from.nick=bob line.privateMessage=false

@b pm hub alice "a word in private"
@a wait ChatReceived hub=hub line.text="a word in private" line.from.nick=bob line.privateMessage=true
