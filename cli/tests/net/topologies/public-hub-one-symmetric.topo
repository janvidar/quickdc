# A hub on the internet and two clients: a behind a home router that keeps
# source ports, b behind one that maps every connection to a random port.
net wan
net home1
net home2
node r1  router wan.11 home1.254 nat=home
node r2  router wan.12 home2.254 nat=symmetric
node hub public wan.20
node a   client home1.10
node b   client home2.10
