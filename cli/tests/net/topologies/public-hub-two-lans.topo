# A hub and an active client on the internet, two clients each behind a home
# router of its own.
net wan
net home1
net home2
node r1  router wan.11 home1.254 nat=home
node r2  router wan.12 home2.254 nat=home
node hub public wan.20
node w   public wan.30
node a   client home1.10
node b   client home2.10
