# Over a lossy, slow, reordering link a logs in, chats both ways and transfers
# both ways with w - byte-identical, and in well under a minute each.

preset application Network Mode advanced
preset application Network Bind6 ""
preset application Network Port 4111
@hub preset application Network Bind ${IP_hub}
@hub preset application "Local hub" Enabled 1
@hub preset application User Nickname hubby
@w preset application Network Bind ${IP_w}
@w preset application Network "Active mode" 1
@w preset application User Nickname wally
@a preset application Network Bind 0.0.0.0
@a preset application Network Mode passive
@a preset application User Nickname alice

@a file share/a.bin 2M 51
@a share share as files
@w file share/w.bin 2M 52
@w share share as files
@a wait ShareStatus hashing=false files=1 timeout=30s
@w wait ShareStatus hashing=false files=1 timeout=30s

@hub open adc://${IP_hub}:4111 as hub
@hub connect hub
@hub wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@w open adc://${IP_hub}:4111 as hub
@w connect hub
@a open adc://${IP_hub}:4111 as hub
@a connect hub
@w wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@a wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@w wait UserUpdated hub=hub user.nick=alice user.addressIPv4=${IP_r1}
@a wait UserUpdated hub=hub user.nick=wally

@a chat hub through the static
@w wait ChatReceived hub=hub line.text="through the static" line.from.nick=alice timeout=20s
@w chat hub heard you
@a wait ChatReceived hub=hub line.text="heard you" line.from.nick=wally timeout=20s

@a search w.bin as s1
@a wait SearchResult hub=hub search=$s1 hit.user.nick=wally timeout=20s
@a download hub w.bin from wally
@a wait DownloadCompleted size=2097152 timeout=60s
@a expect-file downloads/w.bin same-as ../w/share/w.bin

# wally is active, so alice answers over UDP and one lost datagram loses the
# result: ask three times and take whichever answer comes.
@w search a.bin as s2
@w sleep 3s
@w search a.bin as s3
@w sleep 3s
@w search a.bin as s4
@w wait SearchResult hub=hub hit.user.nick=alice timeout=20s
@w download hub a.bin from alice
@w wait DownloadCompleted size=2097152 timeout=60s
@w expect-file downloads/a.bin same-as ../a/share/a.bin
