# b shares a folder while it runs, and a finds a file in it; once b takes the
# folder out again, a search finds nothing there. a is passive, so the answers
# come back through the hub in the order they were asked for.

preset application Network Mode advanced
preset application Network Bind 127.0.0.1
preset application Network Bind6 ""
@a preset application Network Port ${PORT}
@b preset application Network Port ${PORT_B}
@a preset application Network Mode passive
@b preset application Network "Active mode" 1
@a preset application "Local hub" Enabled 1
@a preset application User Nickname alice
@b preset application User Nickname bob

@b file kept/kept.bin 64k 21
@b file fresh/fresh.bin 64k 22
@b share kept as kept
@b wait ShareStatus hashing=false files=1 timeout=30s

@a open adc://127.0.0.1:${PORT} as hub
@a connect hub
@a wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@b open adc://127.0.0.1:${PORT} as hub
@b connect hub
@b wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@a wait UserUpdated hub=hub user.nick=bob

@b share-add fresh
@b wait ShareFolders folders.*.name=fresh
@b wait ShareStatus hashing=false files=2 timeout=30s

@a search fresh.bin as s1
@a wait SearchResult hub=hub hit.token=s1 hit.user.nick=bob

@b share-add fresh/
@b wait ShareFolderRefused why=AlreadyShared

@b share-remove fresh
@b wait ShareFolders folders.*.name!=fresh

@a search fresh.bin as s2
@a search kept.bin as s3
@a wait SearchResult hub=hub hit.token=s3 hit.user.nick=bob
@a expect-no SearchResult hit.token=s2
