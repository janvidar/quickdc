# a is passive by its mode, with "Active mode" still 1 from before the mode
# decided it. It must ask b to connect (RCM) and dial b itself - the download
# is on a connection a made - rather than tell b to dial in (CTM).

preset application Network Mode advanced
preset application Network Bind 127.0.0.1
preset application Network Bind6 ""
preset application Network "Active mode" 1
@a preset application Network Port ${PORT}
@b preset application Network Port ${PORT_B}
@a preset application Network Mode passive
@a preset application "Local hub" Enabled 1
@a preset application User Nickname alice
@b preset application User Nickname bob

@b file share/big.bin 1M 17
@b share share as files

@a state
@a wait ConnectionMode mode=passive activeMode=false
@b wait ShareStatus hashing=false files=1 timeout=30s

@a open adc://127.0.0.1:${PORT} as hub
@a connect hub
@a wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@b open adc://127.0.0.1:${PORT} as hub
@b connect hub
@b wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
@a wait UserUpdated hub=hub user.nick=bob

@a search big.bin as s1
@a wait SearchResult hub=hub search=$s1 hit.user.nick=bob

@a download hub big.bin from bob
@a wait TransferStarted transfer.upload=false transfer.outbound=true timeout=20s
@b wait TransferStarted transfer.upload=true transfer.outbound=false
@a wait DownloadCompleted size=1048576 timeout=20s
@a expect-file downloads/big.bin same-as ../b/share/big.bin
