# Opening a hub records a visit, before it is logged in to, and the name the
# hub gives itself is kept with it.

preset application Network Mode advanced
preset application Network Bind 127.0.0.1
preset application Network Bind6 ""
preset application Network Port ${PORT}
preset application "Local hub" Enabled 1
preset application "Local hub" Name Loopback

open adc://127.0.0.1:${PORT} as hub
wait RecentHubs hubs.0.url=adc://127.0.0.1:${PORT} hubs.0.visited!=0
connect hub
wait HubStatusChanged hub=hub status=LoggedIn timeout=30s
wait RecentHubs hubs.0.url=adc://127.0.0.1:${PORT} hubs.0.name=Loopback

open dchub://127.0.0.1:1 as other
wait RecentHubs hubs.0.url=dchub://127.0.0.1:1 hubs.1.name=Loopback

recent-forget dchub://127.0.0.1:1
wait RecentHubs hubs.0.name=Loopback
recent-clear
wait RecentHubs hubs=[]
